# Local provider plugins and modules
.terraform/

# State files (can contain secrets in plain text)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files that usually hold values or secrets
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config that may contain credentials
.terraformrc
terraform.rc

.terraform.lock.hcl
